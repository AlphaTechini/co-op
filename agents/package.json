{
  "name": "@coop/agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Co-op off-chain swarm: chain client, policy engine, agent runtime, sandbox harness, scenario runner",
  "exports": {
    "./config": "./src/config.ts",
    "./chain": "./src/chain.ts",
    "./money": "./src/money.ts",
    "./policy": "./src/policy.ts",
    "./brief": "./src/brief.ts",
    "./runtime": "./src/runtime.ts",
    "./seller": "./src/seller.ts",
    "./sandbox": "./src/sandbox.ts",
    "./deploy": "./src/deploy.ts",
    "./world": "./src/world.ts",
    "./scenario": "./src/scenario.ts",
    "./roster": "./src/roster.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "check": "tsc -p . && vitest run",
    "scenario": "tsx src/scenario.ts",
    "demo": "tsx src/demo.ts",
    "deploy:testnet": "tsx src/deploy-testnet.ts",
    "deploy:items": "tsx src/deploy-items.ts",
    "lock-contract": "tsx src/lock-contract.ts"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "near-api-js": "7.4.0",
    "near-sandbox": "0.3.4",
    "openai": "7.49.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}

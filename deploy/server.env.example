# Server settings for the VM. Copy to /etc/coop/server.env (mode 600) and fill in.
# Never commit the filled-in file. Every variable is described in server/README.md ("Environment").

NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
# Same values as the repo .env after `pnpm --filter @coop/agents deploy:testnet`.
OPERATOR_ACCOUNT_ID=
OPERATOR_PRIVATE_KEY=
COOP_CONTRACT_ID=
CREDITS_TOKEN_ID=

# Caddy sits in front and sets X-Forwarded-For, so the per-IP limits see real visitors.
TRUST_PROXY=1
# The site's origin, for example https://coop.example.com (comma-separated for several).
CORS_ORIGIN=
SELLER_LOOP=1
PRICE_SCALE=0.05
# Polling every 5 s keeps RPC traffic well inside the free tier's 1 GB of outbound data a month.
RUNTIME_POLL_MS=5000

# Optional LLM brief parser (OpenAI-compatible). Leave empty to use the rules parser.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

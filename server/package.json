{
  "name": "@coop/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Co-op API: spawn-your-agent, activity feed (SSE), config. Embeds the agent runtime.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "demo": "tsx src/demo.ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "check": "tsc -p . && vitest run"
  },
  "dependencies": {
    "@coop/agents": "workspace:*",
    "@fastify/cors": "11.4.0",
    "@fastify/rate-limit": "11.2.2",
    "fastify": "5.12.8",
    "near-api-js": "7.4.0",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}

# Copy to .env and fill in. Never commit .env.

# --- Network -------------------------------------------------------------
# "sandbox" (local, used by `make verify` / `make demo`) or "testnet".
NEAR_NETWORK=testnet
# Testnet RPC. Fallbacks: https://near-testnet.drpc.org, https://testnet-rpc.intea.rs
NEAR_RPC_URL=https://test.rpc.fastnear.com

# --- Accounts ------------------------------------------------------------
# Operator: create with `near create-account <id> --useFaucet --networkId testnet`.
# It deploys the contracts, acts as the demo seller and owns spawned agents.
OPERATOR_ACCOUNT_ID=
OPERATOR_PRIVATE_KEY=
# Filled in by `pnpm --filter @coop/agents deploy:testnet`.
COOP_CONTRACT_ID=
CREDITS_TOKEN_ID=
# Optional extra room items, filled in by `pnpm --filter @coop/agents deploy:items`.
GPU_HOURS_TOKEN_ID=
DATASET_SEATS_TOKEN_ID=

# --- Server (spawn-your-agent API) ---------------------------------------
PORT=8787
SPAWN_MAX_AGENTS=40
SPAWN_MAX_BUDGET_NEAR=2
CORS_ORIGIN=*

# --- Optional LLM (OpenAI-compatible). Leave empty: rules parser is used --
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Web (build-time, read by SvelteKit) ---------------------------------
PUBLIC_NETWORK=testnet
PUBLIC_RPC_URL=https://test.rpc.fastnear.com
PUBLIC_COOP_CONTRACT_ID=
PUBLIC_API_URL=http://localhost:8787
